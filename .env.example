# --- LLM (LiteLLM model strings) ---
# Pick ONE primary provider below by setting LLM_MODEL (and its matching API key).

# Option A: call Anthropic directly.
ANTHROPIC_API_KEY=
# Option B: route through OpenRouter instead (one key, many providers/models).
# Set LLM_MODEL (and JUDGE_MODEL / GUARD_MODEL below) to an "openrouter/<provider>/<model>"
# string, e.g. openrouter/anthropic/claude-3.5-sonnet -- LiteLLM reads OPENROUTER_API_KEY
# automatically for any model string prefixed "openrouter/".
OPENROUTER_API_KEY=

LLM_MODEL=anthropic/claude-sonnet-5
LLM_FALLBACK_MODEL=ollama/qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://ollama:11434
# Point litellm's Anthropic provider at a different base URL (used by CI's fake server).
# Leave empty to call the real Anthropic API.
ANTHROPIC_API_BASE=
# Test hook: 1 = return a canned answer instead of calling any LLM.
LLM_MOCK=0

# --- Retrieval (flip these for ablations) ---
QDRANT_URL=http://qdrant:6333
# dense | hybrid
RETRIEVAL_MODE=hybrid
# 0 | 1
RERANK=0
TOP_K=5

# --- Data ---
DATABASE_URL=postgresql://telecom:telecom@timescale:5432/telecom
REDIS_URL=redis://redis:6379/0

# --- Guardrails ---
# master switch
GUARDRAILS=1
# LLM scope/injection classifier on /ask (adds one small call)
GUARD_LLM=1
GUARD_MODEL=anthropic/claude-haiku-4-5-20251001
# per client on /ask and /incident, 0 = off. Shared across replicas via Redis; falls back
# to a per-replica in-process count if Redis is unreachable.
RATE_LIMIT_PER_MIN=30
# set to require an X-API-Key header on the API
API_KEY=

# --- Evals ---
JUDGE_MODEL=anthropic/claude-haiku-4-5-20251001

# --- Langfuse (create project in UI at :3000, paste keys) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
