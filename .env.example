# --- LLM (LiteLLM model strings) ---
# Pick ONE primary provider below by setting LLM_MODEL (and its matching API key).

# Option A: call Anthropic directly.
ANTHROPIC_API_KEY=
# Option B: route through OpenRouter instead (one key, many providers/models).
# Set LLM_MODEL (and JUDGE_MODEL / GUARD_MODEL below) to an "openrouter/<provider>/<model>"
# string, e.g. openrouter/anthropic/claude-sonnet-5 -- LiteLLM reads OPENROUTER_API_KEY
# automatically for any model string prefixed "openrouter/".
OPENROUTER_API_KEY=

LLM_MODEL=anthropic/claude-sonnet-5
LLM_FALLBACK_MODEL=ollama/qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://ollama:11434

# Self-hosted vLLM (needs a GPU; see docker-compose.vllm.yml). To use it:
#   LLM_MODEL=hosted_vllm/<VLLM_MODEL>   (also JUDGE_MODEL / GUARD_MODEL if you want them local)
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# VLLM_API_KEY=
# VLLM_BASE_URL=http://vllm:8000/v1
# Point litellm's Anthropic provider at a different base URL (used by CI's fake server).
# Leave empty to call the real Anthropic API.
ANTHROPIC_API_BASE=
# Test hook: 1 = return a canned answer instead of calling any LLM.
LLM_MOCK=0

# --- Retrieval (flip these for ablations) ---
QDRANT_URL=http://qdrant:6333
# dense | hybrid
RETRIEVAL_MODE=hybrid
# 0 | 1
RERANK=0
TOP_K=5

# --- Data ---
DATABASE_URL=postgresql://telecom:telecom@timescale:5432/telecom
DB_POOL_MAX=10
REDIS_URL=redis://redis:6379/0

# --- Guardrails ---
# master switch
GUARDRAILS=1
# LLM scope/injection classifier on /ask (adds one small call)
GUARD_LLM=1
GUARD_MODEL=anthropic/claude-haiku-4-5-20251001

# --- Auth ---
# 0 disables auth entirely (every caller is admin) -- local hacking only, never for anything
# reachable by anyone else.
AUTH_REQUIRED=1
# Seed API keys on first migrate: "name:role:key,name:role:key". Roles: operator < approver
# < admin. Prefer scripts/create_api_key.py for anything beyond initial bootstrap; a lost key
# can't be recovered from the hash, only replaced.
BOOTSTRAP_API_KEYS=
# Requests/minute per authenticated user (0 = off). Coarser per-client-IP ceiling underneath
# it catches abuse from callers with no key at all; both are shared across replicas via Redis.
RATE_LIMIT_PER_MIN=30
IP_RATE_LIMIT_PER_MIN=120
# Reverse proxies in front of the API that append to X-Forwarded-For (the prod Caddy counts
# as 1). 0 = trust nothing, use the socket peer address -- correct only when nothing sits in
# front of the API.
TRUSTED_PROXIES=0
# Comma-separated allowed origins for browser clients calling the API directly; empty = no
# CORS headers at all (fine when only the bundled Chainlit UI calls it).
CORS_ORIGINS=
# Set when the API is served under a path prefix behind a reverse proxy, e.g. /api
ROOT_PATH=

# --- Chainlit UI auth (required; every user signs in with their API-key name and key) ---
# Generate with: openssl rand -hex 32. The placeholder below is fine for local/CI use only.
CHAINLIT_AUTH_SECRET=dev-only-chainlit-secret-change-me

# --- Observability ---
LOG_JSON=1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Optional ITSM hand-off: POST every approved ticket here ---
TICKET_WEBHOOK_URL=
TICKET_WEBHOOK_SECRET=

# --- Evals ---
JUDGE_MODEL=anthropic/claude-haiku-4-5-20251001

# --- Langfuse (create a project in the UI at :3000, then paste its keys below) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
# Required by the langfuse container itself (a project's own keys above are separate).
# Placeholders below are fine for local/CI use; generate real ones for any real deployment:
#   openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=dev-only-langfuse-nextauth-secret-change-me
LANGFUSE_SALT=dev-only-langfuse-salt-change-me
LANGFUSE_PUBLIC_URL=http://localhost:3000

# --- Production only (docker-compose.prod.yml); unused otherwise ---
# DOMAIN=ops.example.com
# ACME_EMAIL=you@example.com
# API_WORKERS=4
# GRAFANA_ADMIN_PASSWORD=
# Basic-auth hash for the /grafana/ route: docker run --rm caddy:2-alpine caddy hash-password
# KEEP THE SINGLE QUOTES: the hash contains $ characters, which Compose would otherwise try to
# interpolate and silently corrupt.
# GRAFANA_BASIC_USER=ops
# GRAFANA_BASIC_HASH='$2a$14$...'
